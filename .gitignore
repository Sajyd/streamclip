# --- Secrets and local configuration (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
credentials.json

# --- Local tooling (portable binaries, local database cluster) ---
.tools/
.localdev/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
playwright-report/
test-results/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- Media produced locally (never commit stream data) ---
*.ts.tmp
/media/
/tmp/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
