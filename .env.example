# Local secrets - this file is git-ignored. NEVER commit it.
# Copy to .env and fill in values.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=local
PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://streamclip_owner:streamclip@127.0.0.1:55432/streamclip_dev
# JWT_SIGNING_KEYS=dev:replace-with-long-random-secret-at-least-32-bytes
# BFF_SHARED_SECRET=
# CRON_SECRET=
REGISTRATION_OPEN=true
# Comma-separated platform admins (promoted on API startup)
PLATFORM_ADMIN_EMAILS=sajydmounib@gmail.com

