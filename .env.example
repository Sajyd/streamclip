# STREAMCLIP AI — environment template (no secrets).
# Copy to `.env` for local operator credentials, or set the same keys in Vercel
# (production target only). Never commit a filled copy.

# --- Shared ---------------------------------------------------------------
ENVIRONMENT=local
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=INFO

# --- Database (Neon pooled URL in production) -----------------------------
DATABASE_URL=postgresql://streamclip_owner:streamclip@127.0.0.1:55432/streamclip_dev
# Direct (non-pooled) endpoint for migrations. Defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=

# --- Authentication -------------------------------------------------------
# kid:secret[,kid:secret...]. Each secret ≥ 32 random bytes in production.
JWT_SIGNING_KEYS=local:replace-me-with-openssl-rand-base64-48
# Shared secret between the Next.js BFF and the API (proves the caller is us).
BFF_SHARED_SECRET=replace-me
# Bearer token required by /api/v1/internal/cron/*
CRON_SECRET=replace-me
REGISTRATION_OPEN=true

# --- E-mail ---------------------------------------------------------------
# none | console | smtp | ses. Production starts with none until SES is ready.
EMAIL_TRANSPORT=console
EMAIL_FROM=STREAMCLIP AI <no-reply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SES_REGION=eu-north-1

# --- Stripe (test keys until live processing ships) -----------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Object storage (S3). Vercel reserves AWS_*; use S3_* at runtime. ------
# S3_BUCKET=stream-clip
# S3_REGION=eu-north-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Ingest (MediaMTX) ----------------------------------------------------
# Public hostname publishers connect to (without scheme). Empty = keys can be
# issued but publish URLs stay hidden (ingest_online=false).
# INGEST_PUBLIC_HOST=ingest.example.com
# INGEST_RTMPS_URL=rtmps://ingest.example.com:1935/live/{public_id}
# INGEST_SRT_URL=srt://ingest.example.com:8890?streamid=publish:live/{public_id}:{secret}
# Shared secret for MediaMTX → API webhooks (header x-streamclip-ingest-secret).
# INGEST_HOOK_SECRET=
# Terraform (optional EC2 node): enable_ingest_node=true +
#   ingest_api_auth_url=https://streamclip-phi.vercel.app/api/v1/ingest/hooks/auth

# --- ASR / transcription --------------------------------------------------
# none | console | openai_compatible
ASR_PROVIDER=none
# ASR_API_KEY=
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_MODEL=whisper-large-v3-turbo


# --- Legal identity (shown on /legal/*; leave empty during early access) --
# LEGAL_PUBLISHER=
# LEGAL_CONTACT_EMAIL=

# --- Frontend (local only; API_INTERNAL_URL is a Vercel service binding) --
API_INTERNAL_URL=http://127.0.0.1:8000
