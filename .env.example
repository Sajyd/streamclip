# Local secrets - this file is git-ignored. NEVER commit it.
# Copy to .env and fill in values.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=local
PUBLIC_APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://streamclip_owner:streamclip@127.0.0.1:55432/streamclip_dev
# JWT_SIGNING_KEYS=dev:replace-with-long-random-secret-at-least-32-bytes
# BFF_SHARED_SECRET=
# CRON_SECRET=
REGISTRATION_OPEN=true

# --- Stripe (test) ----------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AWS (AssumeRole). Vercel reserves AWS_ACCESS_KEY_*; use S3_* bootstrap. ---
# Bootstrap keys (iamuser2) are ONLY used for sts:AssumeRole.
# S3 / EC2 / Bedrock clients use temporary credentials from AWS_ROLE_ARN.
# S3_BUCKET=stream-clip
# S3_REGION=eu-north-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT:role/streamclip-production-api
# AWS_ROLE_SESSION_NAME=streamclip-api

# --- Ingest (per-org MediaMTX on t4g.small spot) ----------------------------
# Memorable URL: PUBLIC_APP_URL/rtmp?key=<stream_key>
# → checks subscription + remaining quota → starts a unique EC2 spot →
# 302 redirect to rtmp://{instance-ip}:1935/live
# When RTMP goes idle, the spot is terminated after a 5-minute margin.
# No shared fallback host: each org gets its own IP or resolve fails.
#
# INGEST_HOOK_SECRET=
# INGEST_API_AUTH_URL=https://your.app/api/v1/ingest/hooks/auth
# INGEST_API_EVENT_URL=https://your.app/api/v1/ingest/hooks/event
# INGEST_EC2_AMI_ID=ami-…
# INGEST_EC2_SUBNET_ID=subnet-…
# INGEST_EC2_SECURITY_GROUP_ID=sg-…
# INGEST_EC2_INSTANCE_PROFILE=streamclip-production-ingest-role
# INGEST_EC2_INSTANCE_TYPE=t4g.small
# INGEST_EC2_REGION=eu-north-1

# --- ASR / transcription ----------------------------------------------------
ASR_PROVIDER=none
# ASR_API_KEY=
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_MODEL=whisper-large-v3-turbo

# --- Legal ------------------------------------------------------------------
# LEGAL_PUBLISHER=
# LEGAL_CONTACT_EMAIL=

# --- Frontend (local) -------------------------------------------------------
# API_INTERNAL_URL=http://127.0.0.1:8000
